{
  "name": "Arbitrage Backend",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd /workspace && source .venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    }
  ]
}
